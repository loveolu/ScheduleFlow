# PostgreSQL. docker-compose.yml publishes the container on host port 5434.
DATABASE_URL="postgresql://scheduleflow:scheduleflow@localhost:5434/scheduleflow?schema=public"

# Required. The app throws at startup if this is empty.
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sign-in providers (optional; email + password works without them)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Calendar and video integrations (optional)
OUTLOOK_CLIENT_ID=""
OUTLOOK_CLIENT_SECRET=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# Paid event types (optional)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Outgoing mail. Defaults to a local Mailpit/MailHog on localhost:1025 with no auth.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""
