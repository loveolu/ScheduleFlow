generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
  PRO
  TEAM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum IntegrationType {
  GOOGLE
  OUTLOOK
  ZOOM
  TEAMS
  MEET
  STRIPE
  ZAPIER
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  username          String?   @unique
  passwordHash      String?
  avatarUrl         String?
  timezone          String    @default("America/New_York")
  bio               String?
  stripeCustomerId  String?
  plan              Plan      @default(FREE)
  emailVerified     DateTime?
  image             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  eventTypes        EventType[]
  availabilities    Availability[]
  scheduleOverrides ScheduleOverride[]
  bookings          Booking[]
  webhookSubscriptions WebhookSubscription[]
  integrations      Integration[]
  teamMemberships   TeamMember[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model EventType {
  id                   String   @id @default(cuid())
  userId               String
  title                String
  slug                 String
  description          String?
  duration             Int      @default(30)
  color                String   @default("#6366F1")
  isActive             Boolean  @default(true)
  requiresConfirmation Boolean  @default(false)
  maxInvitees          Int      @default(1)
  bufferTimeBefore     Int      @default(0)
  bufferTimeAfter      Int      @default(0)
  minimumNotice        Int      @default(60)
  maxAdvanceBooking    Int      @default(60)
  maxBookingsPerDay    Int?
  collectPayment       Boolean  @default(false)
  price                Int?
  currency             String   @default("USD")
  locations            Json     @default("[]")
  questions            Json     @default("[]")
  redirectUrl          String?
  hideEventTypeDetails Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability  Availability[]
  bookings      Booking[]

  @@unique([userId, slug])
  @@map("event_types")
}

model Availability {
  id          String  @id @default(cuid())
  userId      String
  eventTypeId String?
  name        String  @default("Working Hours")
  isDefault   Boolean @default(false)
  schedules   Json    @default("[]")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType EventType? @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)

  @@map("availabilities")
}

model ScheduleOverride {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  isBlocked Boolean  @default(false)
  startTime String?
  endTime   String?
  reason    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("schedule_overrides")
}

model Booking {
  id                    String        @id @default(cuid())
  uid                   String        @unique @default(cuid())
  eventTypeId           String
  userId                String
  inviteeName           String
  inviteeEmail          String
  inviteeTimezone       String
  startTime             DateTime
  endTime               DateTime
  status                BookingStatus @default(CONFIRMED)
  cancellationReason    String?
  meetingUrl            String?
  location              String?
  notes                 String?
  remindersSent         Json          @default("[]")
  metadata              Json          @default("{}")
  paymentStatus         PaymentStatus?
  stripePaymentIntentId String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  eventType  EventType          @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendees  BookingAttendee[]

  @@map("bookings")
}

model BookingAttendee {
  id        String @id @default(cuid())
  bookingId String
  name      String
  email     String
  timezone  String

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_attendees")
}

model WebhookSubscription {
  id            String  @id @default(cuid())
  userId        String
  url           String
  events        Json    @default("[]")
  signingSecret String
  isActive      Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("webhook_subscriptions")
}

model Integration {
  id           String          @id @default(cuid())
  userId       String
  type         IntegrationType
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  metadata     Json            @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("integrations")
}

model Team {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  avatarUrl String?
  plan      Plan    @default(FREE)

  members    TeamMember[]
  eventTypes TeamEventType[]

  @@map("teams")
}

model TeamMember {
  id     String   @id @default(cuid())
  teamId String
  userId String
  role   TeamRole @default(MEMBER)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model TeamEventType {
  id                   String   @id @default(cuid())
  teamId               String
  title                String
  slug                 String
  description          String?
  duration             Int      @default(30)
  color                String   @default("#6366F1")
  isActive             Boolean  @default(true)
  requiresConfirmation Boolean  @default(false)
  maxInvitees          Int      @default(1)
  bufferTimeBefore     Int      @default(0)
  bufferTimeAfter      Int      @default(0)
  minimumNotice        Int      @default(60)
  locations            Json     @default("[]")
  questions            Json     @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, slug])
  @@map("team_event_types")
}
